    .footer-brand-column {
      grid-column: 1 / -1;
      grid-row: auto;
      max-width: 430px;
    }

    .footer-contact {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      min-height: 0;
      flex-wrap: wrap;
      justify-content: space-between;
      padding: 17px 0;
    }

    .footer-bottom p:last-child {
      width: 100%;
      order: 3;
    }
