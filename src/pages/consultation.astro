---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Start a conversation with NOVA about a more thoughtful, connected home."
    />
    <meta name="theme-color" content="#090909" />
    <title>Start a Project — NOVA Home Technology</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
      <link rel="stylesheet" href="/site-motion.css" />
    <script src="/site-motion.js" defer></script>
  </head>
  <body>
    <header class="site-header" id="top">
      <a class="brand" href="/" aria-label="NOVA home">
        NOVA<span></span>
      </a>
      <nav aria-label="Primary navigation" id="primary-navigation">
        <a href="/">Home</a>
        <a href="/about" >About</a>
        <a href="/journal">Journal</a>
        <a href="/projects">Projects</a>
        <div class="services-menu">
          <button
            class="services-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Core services <span aria-hidden="true">+</span>
          </button>
          <div class="services-dropdown">
            <a href="/services/security-cameras">Security &amp; Cameras</a>
            <a href="/services/home-network-wifi">Home Network &amp; WiFi</a>
            <a href="/services/whole-home-audio">Whole-Home Audio</a>
            <a href="/services/intelligent-lighting">Intelligent Lighting</a>
            <a href="/services/automated-shades">Automated Shades</a>
            <a href="/services/home-theater">Home Theater</a>
          </div>
        </div>
      </nav>
      <a class="header-cta" href="/consultation">
        Start a project <i aria-hidden="true">&rarr;</i>
      </a>
      <button
        class="menu"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span></span>
        <span></span>
      </button>
    </header>

    <main>
      <section class="about-hero consultation-hero" aria-labelledby="consultation-title">
        <div class="hero-image" role="img" aria-label="A couple speaking with a home design consultant"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <p class="eyebrow"><span></span> Your next step starts here</p>
          <h1 id="consultation-title">Let’s talk about <span>your home.</span></h1>
          <p class="hero-intro">
            Every considered home starts with a conversation. Tell us about your
            space, your ideas and what you’d like technology to make easier.
            We’ll help shape a thoughtful plan around the way you live.
          </p>
        </div>
        <div class="hero-foot">
          <span>Personal guidance. Thoughtful technology.</span>
          <a href="#top">NOVA consultations <span aria-hidden="true">↑</span></a>
        </div>
      </section>
      <section class="consultation" id="contact">
        <div class="consultation-heading">
          <h2>
            Find a time that
            <br />
            <em>works for you.</em>
          </h2>
        </div>
        <div class="booking-layout">
          <div class="booking-visual">
            <img
              src="/images/novara-consultation.jpg"
              alt="A couple meeting with a home design consultant"
              loading="lazy"
            />
            <div class="booking-visual-shade"></div>
            <div class="booking-visual-copy">
              <span>NOVA / PRIVATE CONSULTATION</span>
            </div>
          </div>
          <div class="booking-panel">
            <div class="booking-tabs" role="tablist">
              <button
                class="booking-tab is-active"
                type="button"
                role="tab"
                aria-selected="true"
              >
                Studio visit
              </button>
              <button
                class="booking-tab"
                type="button"
                role="tab"
                aria-selected="false"
              >
                Project call
              </button>
            </div>
            <div class="booking-panel-intro">
              <h3>October 2026</h3>
            </div>
            <div class="booking-weekdays">
              <span>Mon</span>
              <span>Tue</span>
              <span>Wed</span>
              <span>Thu</span>
              <span>Fri</span>
              <span>Sat</span>
              <span>Sun</span>
            </div>
            <div class="booking-days" aria-label="Select a date">
              <button type="button" disabled>
                28
              </button>
              <button type="button" disabled>
                29
              </button>
              <button type="button" disabled>
                30
              </button>
              <button type="button">1</button>
              <button type="button">2</button>
              <button type="button" disabled>
                3
              </button>
              <button type="button" disabled>
                4
              </button>
              <button type="button">5</button>
              <button type="button">6</button>
              <button type="button">7</button>
              <button type="button">8</button>
              <button type="button">9</button>
              <button type="button" disabled>
                10
              </button>
              <button type="button" disabled>
                11
              </button>
              <button type="button">12</button>
              <button type="button">13</button>
              <button type="button">14</button>
              <button type="button">15</button>
              <button type="button">16</button>
              <button type="button" disabled>
                17
              </button>
              <button type="button" disabled>
                18
              </button>
              <button type="button">19</button>
              <button type="button">20</button>
              <button type="button">21</button>
              <button type="button">22</button>
              <button type="button">23</button>
              <button type="button" disabled>
                24
              </button>
              <button type="button" disabled>
                25
              </button>
              <button type="button">26</button>
              <button type="button">27</button>
              <button type="button">28</button>
              <button type="button">29</button>
              <button type="button">30</button>
              <button type="button" disabled>
                31
              </button>
            </div>
            <div class="booking-selection">
              <span>Select a date to view available times.</span>
              <button type="button">
                Continue <b>&rarr;</b>
              </button>
            </div>
          </div>
        </div>
        <div class="consultation-connector">
          <span></span>
          <p>Prefer to write first?</p>
          <span></span>
        </div>
        <div class="contact-studio-card">
          <div class="contact-studio-heading">
            <h3>
              Send a <em>message.</em>
            </h3>
          </div>
          <div class="contact-studio-grid">
            <form class="consultation-form">
              <div class="form-row">
                <label>
                  YOUR NAME
                  <input type="text" placeholder="First and last name" />
                </label>
                <label>
                  EMAIL ADDRESS
                  <input type="email" placeholder="you@example.com" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  PHONE
                  <input type="tel" placeholder="Your preferred number" />
                </label>
                <label>
                  PROJECT LOCATION
                  <input type="text" placeholder="City or postcode" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  PROJECT TYPE
                  <select>
                    <option>Select a project type</option>
                    <option>New build</option>
                    <option>Renovation</option>
                    <option>Focused upgrade</option>
                  </select>
                </label>
                <label>
                  IDEAL TIMELINE
                  <select>
                    <option>Select a timeframe</option>
                    <option>Within 3 months</option>
                    <option>3–6 months</option>
                    <option>6+ months</option>
                  </select>
                </label>
              </div>
              <label class="message-field">
                YOUR NOTE
                <textarea placeholder="Tell us a little about your home and what you have in mind."></textarea>
              </label>
              <button type="submit">
                Send your note <span>&rarr;</span>
              </button>
            </form>
            <div class="contact-studio-image">
              <img
                src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85"
                alt="A contemporary home with thoughtful architectural lighting and integrated technology"
                loading="lazy"
              />
              <span>Visit the NOVA experience studio</span>
            </div>
          </div>
          <div class="contact-studio-footer">
            <a href="tel:+4402071234567">+44 (0)20 7123 4567</a>
            <p>18 Greville Street, London EC1N 8SQ</p>
            <a href="https://maps.google.com/?q=18+Greville+Street+London+EC1N+8SQ">
              Get directions <span>&rarr;</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand-column">
          <a class="footer-logo" href="/" aria-label="NOVA home">
            NOVA<span aria-hidden="true"></span>
          </a>
          <p class="footer-brand-line">
            Intelligent spaces, simply considered. Thoughtful technology,
            designed around the way you live.
          </p>
        </div>
        <nav class="footer-links" aria-label="Experiences">
          <h2>Experiences</h2>
          <a href="/services/home-network-wifi">Smart home control</a>
          <a href="/services/home-theater">Home theater</a>
          <a href="/services/whole-home-audio">Whole-home audio</a>
          <a href="/services/intelligent-lighting">Lighting design</a>
          <a href="/services/automated-shades">Lighting control &amp; shades</a>
          <a href="/services/security-cameras">Security &amp; cameras</a>
        </nav>
        <nav class="footer-links" aria-label="Studio">
          <h2>Studio</h2>
          <a href="/about#our-approach">Our approach</a>
          <a href="/projects">Projects</a>
          <a href="/journal">Journal</a>
          <a href="/#reviews">Client stories</a>
          <a href="#contact">Contact</a>
          <a href="#contact">Service &amp; support</a>
        </nav>
        <div class="footer-links footer-areas">
          <h2>Service areas</h2>
          <span>London</span>
          <span>Greater London</span>
          <span>Surrey &amp; Home Counties</span>
          <span>By consultation</span>
        </div>
        <div class="footer-contact">
          <h2>Visit</h2>
          <p class="footer-location-label">London studio</p>
          <address>
            <span>18 Greville Street,</span>
            <span>London EC1N 8SQ</span>
          </address>
          <a class="footer-phone" href="tel:+4402071234567">
            +44 (0)20 7123 4567
          </a>
          <a
            class="footer-directions"
            href="https://maps.google.com/?q=18+Greville+Street+London+EC1N+8SQ"
          >
            Get directions <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 NOVA Home Technology</p>
        <a href="#top">
          Back to top <span aria-hidden="true">&uarr;</span>
        </a>
        <p>Designed around real life.</p>
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector(".menu");
      const navigation = document.querySelector("#primary-navigation");
      const servicesMenu = document.querySelector(".services-menu");
      const servicesTrigger = document.querySelector(".services-trigger");

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        menuButton.setAttribute(
          "aria-label",
          isOpen ? "Open navigation" : "Close navigation",
        );
        navigation?.classList.toggle("is-open", !isOpen);
      });

      servicesTrigger?.addEventListener("click", () => {
        const isOpen = servicesTrigger.getAttribute("aria-expanded") === "true";
        servicesTrigger.setAttribute("aria-expanded", String(!isOpen));
        servicesMenu?.classList.toggle("is-open", !isOpen);
      });
    </script>
      <script>
      document.querySelectorAll(".booking-tab").forEach((tab) =>
        tab.addEventListener("click", () => {
          document.querySelectorAll(".booking-tab").forEach((item) => {
            item.classList.remove("is-active");
            item.setAttribute("aria-selected", "false");
          });
          tab.classList.add("is-active");
          tab.setAttribute("aria-selected", "true");
        }),
      );
      document
        .querySelectorAll(".booking-days button:not(:disabled)")
        .forEach((day) =>
          day.addEventListener("click", () => {
            document
              .querySelectorAll(".booking-days button")
              .forEach((item) => item.classList.remove("is-selected"));
            day.classList.add("is-selected");
            document.querySelector(".booking-selection span").textContent =
              `Selected October ${day.textContent} - available times will appear here.`;
          }),
        );
      document
        .querySelector(".consultation-form")
        ?.addEventListener("submit", (event) => {
          event.preventDefault();
          const button = event.currentTarget.querySelector("button");
          button.innerHTML = "Message received <span>&rarr;</span>";
        });
    </script>
  </body>
</html>

<style>
  :root {
    --color-background: #090909;
    --color-surface: #11120f;
    --color-text: #f4f1ea;
    --color-text-muted: #d0ccc3;
    --color-accent: #bf974e;
    --color-border: rgba(244, 241, 234, 0.2);
    --color-accent-hover: #d4ae68;
    --primary: "Montserrat", sans-serif;
    --sans: "Poppins", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--sans);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    height: 82px;
    align-items: center;
    padding: 0 clamp(22px, 3.2vw, 64px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(5, 5, 5, 0.94);
    color: #fff;
    backdrop-filter: blur(12px);
  }

  .brand {
    display: inline-flex;
    align-items: flex-start;
    font: 700 28px/1 var(--primary);
    letter-spacing: -0.08em;
  }

  .brand span {
    width: 7px;
    height: 7px;
    margin: 3px 0 0 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 31px);
    margin: 0 clamp(25px, 4vw, 70px) 0 auto;
    font-size: 14px;
    font-weight: 500;
  }

  .site-header nav > a {
    color: rgba(255, 255, 255, 0.88);
    transition: color 180ms ease;
  }

  .site-header nav > a:hover {
    color: #fff;
  }

  .site-header nav > a[aria-current="page"] {
    color: #fff;
  }

  .services-menu {
    position: relative;
    display: flex;
    height: 40px;
    align-items: center;
    font: inherit;
  }

  .services-trigger {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  .services-trigger span {
    color: var(--color-accent-hover);
    font: 18px/1 var(--sans);
    transition: transform 180ms ease;
  }

  .services-menu:hover .services-trigger span,
  .services-menu:focus-within .services-trigger span,
  .services-menu.is-open .services-trigger span {
    transform: rotate(45deg);
  }

  .services-dropdown {
    position: absolute;
    top: 40px;
    right: -14px;
    width: 238px;
    padding: 9px 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: #090909;
    box-shadow: 0 19px 45px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(7px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
  }

  .services-menu:hover .services-dropdown,
  .services-menu:focus-within .services-dropdown,
  .services-menu.is-open .services-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .services-dropdown a {
    display: block;
    padding: 11px 15px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 13px;
    font-weight: 500;
    transition: color 160ms ease, background 160ms ease;
  }

  .services-dropdown a:hover {
    background: #171715;
    color: var(--color-accent-hover);
  }

  .header-cta {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 11px;
    padding: 0 19px;
    border-radius: 999px;
    background: #b89654;
    color: #171108;
    font-size: 14px;
    font-weight: 600;
    transition: background 180ms ease, transform 180ms ease;
  }

  .header-cta:hover {
    transform: translateY(-1px);
    background: #d0ae6c;
  }

  .header-cta i {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    color: #fff;
    font: normal 15px/1 Arial, sans-serif;
  }

  .menu {
    display: none;
  }

  .about-hero {
    position: relative;
    display: grid;
    min-height: max(760px, 100svh);
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: 150px 28px 100px;
    text-align: center;
  }

  .hero-image,
  .hero-overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .hero-image {
    background-image: url("/images/novara-consultation.jpg");
    background-position: center 52%;
    background-size: cover;
    transform: scale(1.015);
  }

  .hero-overlay {
    background:
      linear-gradient(180deg, rgba(9, 9, 9, 0.45) 0%, rgba(9, 9, 9, 0.38) 28%, rgba(9, 9, 9, 0.7) 57%, #090909 100%),
      linear-gradient(90deg, rgba(9, 9, 9, 0.36), rgba(9, 9, 9, 0.05) 50%, rgba(9, 9, 9, 0.36));
  }

  .hero-content {
    width: min(100%, 1080px);
    margin: auto;
    padding-top: 28px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    margin: 0 0 20px;
    color: #e2c891;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 26px;
    font: 500 clamp(48px, 6.3vw, 82px)/1.04 var(--primary);
    letter-spacing: -0.065em;
  }

  h1 span {
    color: #e2c891;
  }

  .hero-intro {
    max-width: 970px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(16px, 1.65vw, 23px);
    line-height: 1.8;
  }

  .hero-belief {
    max-width: 760px;
    margin: 36px auto 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(17px, 1.8vw, 25px);
    line-height: 1.5;
  }

  .hero-belief strong {
    color: #fff;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 42px;
  }

  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .button span {
    font-size: 16px;
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(8, 8, 8, 0.2);
    color: #fff;
  }

  .button-secondary:hover {
    border-color: var(--color-accent);
    color: #e2c891;
  }

  .button-primary {
    background: var(--color-accent);
    color: #1b150a;
  }

  .hero-foot {
    position: absolute;
    right: clamp(22px, 3.2vw, 64px);
    bottom: 27px;
    left: clamp(22px, 3.2vw, 64px);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-foot a span {
    margin-left: 7px;
    color: var(--color-accent-hover);
    font-size: 14px;
  }

  .approach {
    padding: clamp(70px, 7vw, 100px) 24px 112px;
    background: var(--color-background);
  }

  .approach-inner {
    width: min(100%, 1200px);
    margin: 0 auto;
  }

  .opening-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .opening-images img {
    display: block;
    width: 100%;
    aspect-ratio: 1.58;
    object-fit: cover;
  }

  .approach-intro {
    max-width: 900px;
    margin: clamp(58px, 7vw, 86px) 0 0;
  }

  .approach-intro .eyebrow {
    justify-content: flex-start;
    margin-bottom: 16px;
  }

  .approach-intro h2 {
    margin: 0 0 20px;
    font: 500 clamp(36px, 4.3vw, 56px)/1.08 var(--primary);
    letter-spacing: -0.06em;
  }

  .approach-intro h2 em {
    color: #d4ae68;
    font-weight: 500;
  }

  .approach-intro > p:last-child {
    max-width: 880px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.85;
  }

  .story-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(48px, 6vw, 72px);
  }

  .story-images img {
    display: block;
    width: 100%;
    aspect-ratio: 0.8;
    object-fit: cover;
  }

  .approach-quote {
    max-width: 590px;
    margin: 64px auto 0;
    text-align: center;
  }

  .approach-quote blockquote {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .approach-quote blockquote strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .approach-quote figcaption {
    margin-top: 25px;
    color: var(--color-accent-hover);
    font-size: 13px;
  }

  .what-we-do {
    padding: clamp(82px, 10vw, 132px) 24px clamp(90px, 11vw, 145px);
    background: #050505;
  }

