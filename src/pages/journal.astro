---
import { journalPosts } from "../data/journalPosts.js";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Stories, ideas and practical inspiration for more thoughtful connected living from NOVA."
    />
    <meta name="theme-color" content="#090909" />
    <title>The NOVA Journal — Ideas for thoughtful connected living</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
      <link rel="stylesheet" href="/site-motion.css" />
    <script src="/site-motion.js" defer></script>
  </head>
  <body>
    <header class="site-header" id="top">
      <a class="brand" href="/" aria-label="NOVA home">
        NOVA<span></span>
      </a>
      <nav aria-label="Primary navigation" id="primary-navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/journal" aria-current="page">Journal</a>
        <a href="/projects">Projects</a>
        <div class="services-menu">
          <button
            class="services-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Core services <span aria-hidden="true">+</span>
          </button>
          <div class="services-dropdown">
            <a href="/services/security-cameras">Security &amp; Cameras</a>
            <a href="/services/home-network-wifi">Home Network &amp; WiFi</a>
            <a href="/services/whole-home-audio">Whole-Home Audio</a>
            <a href="/services/intelligent-lighting">Intelligent Lighting</a>
            <a href="/services/automated-shades">Automated Shades</a>
            <a href="/services/home-theater">Home Theater</a>
          </div>
        </div>
      </nav>
      <a class="header-cta" href="/consultation">
        Start a project <i aria-hidden="true">&rarr;</i>
      </a>
      <button
        class="menu"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span></span>
        <span></span>
      </button>
    </header>

    <main>
      <section class="about-hero journal-hero" aria-labelledby="journal-title">
        <div class="hero-image" role="img" aria-label="A couple exploring ideas for their home together"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <p class="eyebrow"><span></span> The NOVA Journal</p>
          <h1 id="journal-title">Ideas for living <span>beautifully.</span></h1>
          <p class="hero-intro">
            Thoughtful perspectives on connected living, considered design and
            the details that make a home feel effortless. Explore ideas, guides
            and inspiration from the NOVA team.
          </p>
          <div class="hero-actions">
            <a class="button button-secondary" href="#journal">
              Explore the journal <span aria-hidden="true">↓</span>
            </a>
            <a class="button button-primary" href="/consultation">
              Start a project <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="hero-foot">
          <span>Design, technology &amp; everyday living</span>
          <a href="#journal">Read the latest <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="journal-page" id="journal" aria-labelledby="journal-heading">

        <div class="journal-page-grid">
          {journalPosts.map((post, index) => (
            <a
              class:list={[
                "journal-card",
                {
                  "is-featured": index === 0 || index === 8,
                  "is-wide": index === 6 || index === 9,
                },
              ]}
              href={"/journal/" + post.slug}
            >
              <img src={post.image} alt={post.alt} loading="lazy" />
              <div class="journal-card-shade"></div>
              <div class="journal-card-content">
                <p>{post.category}</p>
                <h3>{post.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand-column">
          <a class="footer-logo" href="/" aria-label="NOVA home">
            NOVA<span aria-hidden="true"></span>
          </a>
          <p class="footer-brand-line">
            Intelligent spaces, simply considered. Thoughtful technology,
            designed around the way you live.
          </p>
        </div>
        <nav class="footer-links" aria-label="Experiences">
          <h2>Experiences</h2>
          <a href="/services/home-network-wifi">Smart home control</a>
          <a href="/services/home-theater">Home theater</a>
          <a href="/services/whole-home-audio">Whole-home audio</a>
          <a href="/services/intelligent-lighting">Lighting design</a>
          <a href="/services/automated-shades">Lighting control &amp; shades</a>
          <a href="/services/security-cameras">Security &amp; cameras</a>
        </nav>
        <nav class="footer-links" aria-label="Studio">
          <h2>Studio</h2>
          <a href="/about#our-approach">Our approach</a>
          <a href="/projects">Projects</a>
          <a href="/journal">Journal</a>
          <a href="/#reviews">Client stories</a>
          <a href="/#contact">Contact</a>
          <a href="/#contact">Service &amp; support</a>
        </nav>
        <div class="footer-links footer-areas">
          <h2>Service areas</h2>
          <span>London</span>
          <span>Greater London</span>
          <span>Surrey &amp; Home Counties</span>
          <span>By consultation</span>
        </div>
        <div class="footer-contact">
          <h2>Visit</h2>
          <p class="footer-location-label">London studio</p>
          <address>
            <span>18 Greville Street,</span>
            <span>London EC1N 8SQ</span>
          </address>
          <a class="footer-phone" href="tel:+4402071234567">
            +44 (0)20 7123 4567
          </a>
          <a
            class="footer-directions"
            href="https://maps.google.com/?q=18+Greville+Street+London+EC1N+8SQ"
          >
            Get directions <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 NOVA Home Technology</p>
        <a href="#top">
          Back to top <span aria-hidden="true">&uarr;</span>
        </a>
        <p>Designed around real life.</p>
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector(".menu");
      const navigation = document.querySelector("#primary-navigation");
      const servicesMenu = document.querySelector(".services-menu");
      const servicesTrigger = document.querySelector(".services-trigger");

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        menuButton.setAttribute(
          "aria-label",
          isOpen ? "Open navigation" : "Close navigation",
        );
        navigation?.classList.toggle("is-open", !isOpen);
      });

      servicesTrigger?.addEventListener("click", () => {
        const isOpen = servicesTrigger.getAttribute("aria-expanded") === "true";
        servicesTrigger.setAttribute("aria-expanded", String(!isOpen));
        servicesMenu?.classList.toggle("is-open", !isOpen);
      });
    </script>
  </body>
</html>

<style>
  :root {
    --color-background: #090909;
    --color-surface: #11120f;
    --color-text: #f4f1ea;
    --color-text-muted: #d0ccc3;
    --color-accent: #bf974e;
    --color-border: rgba(244, 241, 234, 0.2);
    --color-accent-hover: #d4ae68;
    --primary: "Montserrat", sans-serif;
    --sans: "Poppins", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--sans);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    height: 82px;
    align-items: center;
    padding: 0 clamp(22px, 3.2vw, 64px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(5, 5, 5, 0.94);
    color: #fff;
    backdrop-filter: blur(12px);
  }

  .brand {
    display: inline-flex;
    align-items: flex-start;
    font: 700 28px/1 var(--primary);
    letter-spacing: -0.08em;
  }

  .brand span {
    width: 7px;
    height: 7px;
    margin: 3px 0 0 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 31px);
    margin: 0 clamp(25px, 4vw, 70px) 0 auto;
    font-size: 14px;
    font-weight: 500;
  }

  .site-header nav > a {
    color: rgba(255, 255, 255, 0.88);
    transition: color 180ms ease;
  }

  .site-header nav > a:hover {
    color: #fff;
  }

  .site-header nav > a[aria-current="page"] {
    color: #fff;
  }

  .services-menu {
    position: relative;
    display: flex;
    height: 40px;
    align-items: center;
    font: inherit;
  }

  .services-trigger {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  .services-trigger span {
    color: var(--color-accent-hover);
    font: 18px/1 var(--sans);
    transition: transform 180ms ease;
  }

  .services-menu:hover .services-trigger span,
  .services-menu:focus-within .services-trigger span,
  .services-menu.is-open .services-trigger span {
    transform: rotate(45deg);
  }

  .services-dropdown {
    position: absolute;
    top: 40px;
    right: -14px;
    width: 238px;
    padding: 9px 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: #090909;
    box-shadow: 0 19px 45px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(7px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
  }

  .services-menu:hover .services-dropdown,
  .services-menu:focus-within .services-dropdown,
  .services-menu.is-open .services-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .services-dropdown a {
    display: block;
    padding: 11px 15px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 13px;
    font-weight: 500;
    transition: color 160ms ease, background 160ms ease;
  }

  .services-dropdown a:hover {
    background: #171715;
    color: var(--color-accent-hover);
  }

  .header-cta {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 11px;
    padding: 0 19px;
    border-radius: 999px;
    background: #b89654;
    color: #171108;
    font-size: 14px;
    font-weight: 600;
    transition: background 180ms ease, transform 180ms ease;
  }

  .header-cta:hover {
    transform: translateY(-1px);
    background: #d0ae6c;
  }

  .header-cta i {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    color: #fff;
    font: normal 15px/1 Arial, sans-serif;
  }

  .menu {
    display: none;
  }

  .about-hero {
    position: relative;
    display: grid;
    min-height: max(760px, 100svh);
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: 150px 28px 100px;
    text-align: center;
  }

  .hero-image,
  .hero-overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .hero-image {
    background-image: url("/images/novara-journal.jpg");
    background-position: center 55%;
    background-size: cover;
    transform: scale(1.015);
  }

  .hero-overlay {
    background:
      linear-gradient(180deg, rgba(9, 9, 9, 0.45) 0%, rgba(9, 9, 9, 0.38) 28%, rgba(9, 9, 9, 0.7) 57%, #090909 100%),
      linear-gradient(90deg, rgba(9, 9, 9, 0.36), rgba(9, 9, 9, 0.05) 50%, rgba(9, 9, 9, 0.36));
  }

  .hero-content {
    width: min(100%, 1080px);
    margin: auto;
    padding-top: 28px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    margin: 0 0 20px;
    color: #e2c891;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 26px;
    font: 500 clamp(48px, 6.3vw, 82px)/1.04 var(--primary);
    letter-spacing: -0.065em;
  }

  h1 span {
    color: #e2c891;
  }

  .hero-intro {
    max-width: 970px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(16px, 1.65vw, 23px);
    line-height: 1.8;
  }

  .hero-belief {
    max-width: 760px;
    margin: 36px auto 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(17px, 1.8vw, 25px);
    line-height: 1.5;
  }

  .hero-belief strong {
    color: #fff;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 42px;
  }

  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .button span {
    font-size: 16px;
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(8, 8, 8, 0.2);
    color: #fff;
  }

  .button-secondary:hover {
    border-color: var(--color-accent);
    color: #e2c891;
  }

  .button-primary {
    background: var(--color-accent);
    color: #1b150a;
  }

  .hero-foot {
    position: absolute;
    right: clamp(22px, 3.2vw, 64px);
    bottom: 27px;
    left: clamp(22px, 3.2vw, 64px);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-foot a span {
    margin-left: 7px;
    color: var(--color-accent-hover);
    font-size: 14px;
  }

  .approach {
    padding: clamp(70px, 7vw, 100px) 24px 112px;
    background: var(--color-background);
  }

  .approach-inner {
    width: min(100%, 1200px);
    margin: 0 auto;
  }

  .opening-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .opening-images img {
    display: block;
    width: 100%;
    aspect-ratio: 1.58;
    object-fit: cover;
  }

  .approach-intro {
    max-width: 900px;
    margin: clamp(58px, 7vw, 86px) 0 0;
  }

  .approach-intro .eyebrow {
    justify-content: flex-start;
    margin-bottom: 16px;
  }

  .approach-intro h2 {
    margin: 0 0 20px;
    font: 500 clamp(36px, 4.3vw, 56px)/1.08 var(--primary);
    letter-spacing: -0.06em;
  }

  .approach-intro h2 em {
    color: #d4ae68;
    font-weight: 500;
  }

  .approach-intro > p:last-child {
    max-width: 880px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.85;
  }

  .story-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(48px, 6vw, 72px);
  }

  .story-images img {
    display: block;
    width: 100%;
    aspect-ratio: 0.8;
    object-fit: cover;
  }

  .approach-quote {
    max-width: 590px;
    margin: 64px auto 0;
    text-align: center;
  }

  .approach-quote blockquote {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .approach-quote blockquote strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .approach-quote figcaption {
    margin-top: 25px;
    color: var(--color-accent-hover);
    font-size: 13px;
  }

  .what-we-do {
    padding: clamp(82px, 10vw, 132px) 24px clamp(90px, 11vw, 145px);
    background: #050505;
  }

  .what-inner {
    width: min(100%, 1240px);
    margin: 0 auto;
  }

  .what-we-do > .what-inner > .eyebrow {
    margin-bottom: 14px;
  }

  .what-we-do h2 {
    margin: 0 0 clamp(54px, 7vw, 88px);
    color: var(--color-text);
    font: 500 clamp(46px, 5.3vw, 68px)/1.05 var(--primary);
    letter-spacing: -0.06em;
    text-align: center;
  }

  .what-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .what-column {
    min-width: 0;
  }

  .what-item {
    display: flex;
    min-height: 78px;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(244, 241, 234, 0.18);
    color: #f4f1ea;
    font-size: clamp(15px, 1.35vw, 19px);
    font-weight: 500;
    text-align: center;
    transition: background 180ms ease, color 180ms ease;
  }

  .what-item:hover {
    background: #323232;
    color: #fff;
  }

  .about-closer {
    position: relative;
    display: grid;
    min-height: max(760px, 100svh);
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: 120px 28px;
    text-align: center;
  }

  .closing-image,
  .closing-overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .closing-image {
    background-image: url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2400&q=90");
    background-position: center 54%;
    background-size: cover;
    transform: scale(1.02);
  }

  .closing-overlay {
    background:
      radial-gradient(ellipse at 24% 58%, rgba(98, 67, 24, 0.42), transparent 44%),
      linear-gradient(180deg, rgba(5, 5, 5, 0.54), rgba(5, 5, 5, 0.68) 55%, rgba(5, 5, 5, 0.76)),
      linear-gradient(90deg, rgba(5, 5, 5, 0.38), rgba(5, 5, 5, 0.12) 50%, rgba(5, 5, 5, 0.38));
  }

  .closing-content {
    width: min(100%, 1000px);
    margin: auto;
  }

  .closing-content .eyebrow {
    margin-bottom: 24px;
  }

  .closing-title {
    max-width: 960px;
    margin: 0 auto 25px;
    font: 500 clamp(44px, 6vw, 82px)/1.08 var(--primary);
    letter-spacing: -0.06em;
  }

  .closing-title em {
    position: relative;
    display: inline-block;
    color: #e2c891;
    font-style: normal;
    font-weight: 500;
  }

  .closing-title em::after {
    position: absolute;
    right: 0.02em;
    bottom: -0.08em;
    left: 0.02em;
    height: 3px;
    border-radius: 50%;
    background: var(--color-accent);
    content: "";
    transform: rotate(-2deg);
  }

  .closing-copy {
    max-width: 840px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(15px, 1.35vw, 19px);
    line-height: 1.75;
  }

  .closing-cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 18px;
    margin-top: 58px;
    padding: 0 9px 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 999px;
    background: rgba(7, 7, 7, 0.34);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .closing-cta span {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: #1b150a;
    font-size: 15px;
  }

  .closing-cta:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent-hover);
    background: rgba(7, 7, 7, 0.62);
  }

  @media (max-width: 900px) {
    .site-header {
      height: 80px;
    }

    .site-header nav {
      gap: 19px;
      margin-right: 24px;
      font-size: 12px;
    }

    .header-cta {
      min-height: 38px;
      padding: 0 14px;
      font-size: 12px;
    }

    .about-closer {
      min-height: max(700px, 100svh);
    }

    .about-hero {
      min-height: max(700px, 100svh);
      padding: 130px 30px 100px;
    }

    .hero-intro {
      max-width: 750px;
    }

    .approach {
      padding-right: 30px;
      padding-left: 30px;
    }
  }

  @media (max-width: 680px) {
    .site-header {
      height: 74px;
      padding: 0 22px;
    }

    .brand {
      font-size: 25px;
    }

    .site-header nav {
      position: absolute;
      top: 74px;
      right: 16px;
      left: 16px;
      display: none;
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 10px 20px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 14px;
      background: rgba(13, 13, 12, 0.97);
      backdrop-filter: blur(16px);
