const coreServices = [
  {
    number: "01",
    label: "NOVA CONTROL",
    title: "Security & Cameras",
    description:
      "See more. Know more. Protect what matters with intelligent surveillance designed discreetly into the architecture.",
    detail:
      "From a simple camera system to intelligent monitoring across the entire property, security stays clear, fast and quietly reliable.",
    tag: "Explore security",
    href: "/services/security-cameras",
    image:
      "/images/security-night-home.webp",
  },
  {
    number: "02",
    label: "CONNECTED HOME",
    title: "Home Network & WiFi",
    description:
      "A fast, resilient connection that quietly supports every part of modern living.",
    detail:
      "Built to support every room, device and moment without the frustration of weak signals or interrupted performance.",
    tag: "Explore networking",
    href: "/services/home-network-wifi",
    image:
      "/images/network-luxury-access.webp",
  },
  {
    number: "03",
    label: "SOUND, EVERYWHERE",
    title: "Whole-Home Audio",
    description:
      "Exceptional sound in every room, designed to be heard and not seen.",
    detail:
      "Architectural speakers and thoughtful tuning bring beautiful, balanced sound to the spaces where life happens.",
    tag: "Explore audio",
    href: "/services/whole-home-audio",
    image:
      "/images/audio-luxury-architecture.webp",
  },
  {
    number: "04",
    label: "LIGHT, PERFECTED",
    title: "Intelligent Lighting",
    description:
      "Layered, responsive illumination that changes the atmosphere at exactly the right moment.",
    detail:
      "Create effortless scenes that enhance architecture, support your routine and make every gathering feel considered.",
    tag: "Explore lighting",
    href: "/services/intelligent-lighting",
    image:
      "/images/lighting-night-hero.webp",
  },
  {
    number: "05",
    label: "DAYLIGHT, DESIGNED",
    title: "Automated Shades",
    description:
      "Light, privacy and comfort move in harmony with the rhythm of your home.",
    detail:
      "Quiet, precise shading protects interiors and gives every space a more comfortable, private atmosphere.",
    tag: "Explore shades",
    href: "/services/automated-shades",
    image:
      "/images/shades-luxury-living.webp",
  },
  {
    number: "06",
    label: "THE CINEMA EXPERIENCE",
    title: "Home Theater",
    description:
      "A cinematic world, tailored to the way you watch, listen and escape.",
    detail:
      "From media rooms to dedicated theaters, every detail is tuned for extraordinary picture, sound and comfort.",
    tag: "Explore theater",
    href: "/services/home-theater",
    image:
      "/images/home-theater-private.webp",
  },
];
const systems = [
  [
    "01",
    "Home control",
    "One elegant interface for every room, scene, and moment.",
    "https://images.unsplash.com/photo-1558002038-1055907df827?auto=format&fit=crop&w=1200&q=85",
  ],
  [
    "02",
    "Light & shade",
    "Natural light, precisely shaped throughout the day.",
    "/images/shades-luxury-living.webp",
  ],
  [
    "03",
    "Sound & cinema",
    "Immersive experiences designed into the architecture.",
    "/images/audio-luxury-architecture.webp",
  ],
  [
    "04",
    "Security & network",
    "Protection and performance that quietly stay ahead.",
    "/images/security-night-home.webp",
  ],
