  /* NOVA global design system: one palette and one typographic hierarchy */
  :root {
    --color-background: #090909;
    --color-surface: #11120f;
    --color-surface-raised: #191a16;
    --color-text: #f4f1ea;
    --color-text-muted: #b8b3a8;
    --color-accent: #bf974e;
    --color-accent-hover: #d4ae68;
    --color-accent-contrast: #171108;
    --color-border: rgba(244, 241, 234, 0.2);
    --primary: "Montserrat", sans-serif;
    --sans: "Poppins", sans-serif;
    --mono: "Poppins", sans-serif;
    --serif: "Montserrat", sans-serif;
    --paper: var(--color-background);
    --ink: var(--color-text);
    --lime: var(--color-accent);
    --charcoal: var(--color-surface-raised);
    --muted: var(--color-text-muted);
  }
  body {
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--sans);
    font-weight: 400;
  }
  h1,
  h2,
  h3,
  .project-meta h3,
  .work-heading h2 {
    font-family: var(--primary);
    font-weight: 500;
    letter-spacing: -0.055em;
  }
  .header-cta,
  .contact-form button {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .header-cta:hover {
    background: var(--color-accent-hover);
  }
  .header-cta i {
    background: rgba(23, 17, 8, 0.45);
    color: var(--color-text);
  }
  .services-trigger span,
  .hero-foot b,
  .circle-link b,
  .system-content a {
    color: var(--color-accent);
  }
  .circle-link:hover,
  .project-controls button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .services-dropdown {
    background: var(--color-surface-raised);
    border-color: var(--color-border);
  }
  .services-dropdown a:hover {
    color: var(--color-accent-hover);
    background: rgba(255, 255, 255, 0.05);
  }
  .project-controls button {
    border-color: var(--color-border);
    color: var(--color-text);
  }
  .projects-kicker,
  .manifesto-copy > p,
  .systems-intro > p,
  .studio-words p,
  .contact-copy > p:not(.eyebrow) {
    color: var(--color-text-muted);
  }
  .project-meta p {
    font-family: var(--sans);
    font-weight: 500;
  }
  .project-meta h3 {
    font-family: var(--primary);
    font-weight: 500;
  }
  .view-all {
    font-family: var(--sans);
    font-weight: 600;
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: var(--sans);
  }
  /* Arrow-only project action */
  .project-meta {
    padding-right: 78px;
  }
  .project-meta .project-action {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 60px;
    height: 60px;
    margin: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font:
      0/1 Arial,
      sans-serif;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .project-meta .project-action b {
    margin: 0;
    font:
      24px/1 Arial,
      sans-serif;
    font-weight: 400;
  }
  .project:hover .project-action {
    background: var(--color-accent-hover);
    transform: translateX(3px);
  }
  @media (max-width: 800px) {
    .project-meta {
      padding-right: 66px;
    }
    .project-meta .project-action {
      width: 52px;
      height: 52px;
    }
    .project-meta .project-action b {
      font-size: 21px;
    }
  }
  /* Animated core-services showcase */
  .service-showcase {
    padding: 142px 8.5vw;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .service-showcase-intro {
    display: grid;
    grid-template-columns: 0.8fr 1.35fr 0.9fr;
    gap: 42px;
    align-items: start;
    margin-bottom: 100px;
  }
  .service-showcase-intro h2 {
    margin: 0;
    font-size: clamp(48px, 5.1vw, 82px);
    line-height: 0.94;
  }
  .service-showcase-intro > p:last-child {
    margin: 8px 0 0;
    max-width: 340px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
  .service-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
  }
  .service-container {
    min-height: 385px;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-surface-raised);
  }
  .service-container-link {
    position: relative;
    display: block;
    height: 100%;
    min-height: 385px;
  }
  .service-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .service-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.02) 25%,
      rgba(0, 0, 0, 0.82) 100%
    );
  }
  .service-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .service-container-content {
    position: absolute;
    z-index: 1;
    right: 28px;
    bottom: 27px;
    left: 28px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 22px;
    align-items: end;
    color: var(--color-text);
  }
  .service-number {
    font: 500 12px var(--sans);
    color: var(--color-accent);
    padding-bottom: 7px;
  }
  .service-container h3 {
    margin: 0 0 10px;
    font-size: clamp(26px, 2.5vw, 39px);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .service-container p {
    max-width: 420px;
    margin: 0;
    color: rgba(244, 241, 234, 0.83);
    font-size: 14px;
    line-height: 1.6;
  }
  .service-arrow {
    width: 51px;
    height: 51px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font:
      22px/1 Arial,
      sans-serif;
    transition:
      transform 0.25s,
      background 0.25s;
  }
  .service-container:hover .service-media img {
    transform: scale(1.07);
  }
  .service-container:hover .service-arrow {
    background: var(--color-accent-hover);
    transform: translateX(5px);
  }
  .service-list.is-enhanced .service-container {
    opacity: 0;
    transform: translateY(45px);
    transition:
      opacity 0.65s ease,
      transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .service-list.is-enhanced .service-container.is-visible {
    opacity: 1;
