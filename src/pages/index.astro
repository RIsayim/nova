---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="NOVA is a considered home technology studio for extraordinary spaces."
    />
    <title>NOVA - Intelligent spaces, simply considered.</title>
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Nova home">
        NOVA<span></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#top">Home</a>
        <a href="/about">About</a>
        <a href="/journal">Journal</a>
        <a href="/projects">Projects</a>
        <div class="services-menu">
          <button class="services-trigger" type="button" aria-haspopup="true">
            Core services <span>+</span>
          </button>
          <div class="services-dropdown">
            <a href="/services/security-cameras">Security &amp; Cameras</a>
            <a href="/services/home-network-wifi">Home Network &amp; WiFi</a>
            <a href="/services/whole-home-audio">Whole-Home Audio</a>
            <a href="/services/intelligent-lighting">Intelligent Lighting</a>
            <a href="/services/automated-shades">Automated Shades</a>
            <a href="/services/home-theater">Home Theater</a>
          </div>
        </div>
      </nav>
      <a class="header-cta" href="/consultation">
        Start a project <i aria-hidden="true">&rarr;</i>
      </a>
      <button class="menu" aria-label="Open menu">
        <span></span>
        <span></span>
      </button>
    </header>
    <main>
      <section class="hero">
        <video
          class="hero-media"
          autoplay
          muted
          loop
          playsinline
          poster="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&amp;fit=crop&amp;w=2200&amp;q=90"
        >
          <source src="/hero-walkthrough.mp4" type="video/mp4" />
        </video>
        <div class="hero-shade"></div>
        <div class="hero-copy">
          <p class="eyebrow light">Independent home technology studio</p>
          <h1>
            Life, <em>beautifully</em>
            <br />
            orchestrated.
          </h1>
          <p class="hero-intro">
            Technology that feels like it has always belonged. We create
            intuitive, enduring smart homes for remarkable spaces.
          </p>
        </div>
        <div class="hero-foot">
          <span>Est. 2009 &middot; London &amp; beyond</span>
          <span>
            Scroll to discover <b>&darr;</b>
          </span>
        </div>
      </section>
      <section class="work section-pad" id="work">
        <div class="work-heading">
          <div>
            <p class="projects-kicker">Explore our</p>
            <h2>
              Recent <em>projects.</em>
            </h2>
          </div>
          <div class="project-actions">
            <a class="view-all" href="/projects">
              View all <span>&rarr;</span>
            </a>
            <div
              class="project-controls"
              aria-label="Project carousel controls"
            >
              <button
                type="button"
                data-project-prev
                aria-label="Previous projects"
              >
                &larr;
              </button>
              <button
                type="button"
                data-project-next
                aria-label="Next projects"
              >
                &rarr;
              </button>
            </div>
          </div>
        </div>
        <div
          class="projects-carousel"
          data-project-carousel
          tabindex="0"
          aria-label="Selected projects"
        >
          <div class="projects">
            {projects.map((project) => (
              <article class="project">
                <a href={"/projects/" + project.slug} class="project-image">
                  <img src={project.image} alt={project.title} loading="lazy" />
                  <div class="project-meta">
                    <p>{project.type}</p>
                    <h3>{project.title}</h3>
                    <span class="project-action" aria-label="View project">
                      <b>&rarr;</b>
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="service-showcase" id="core-services">
        <div class="service-showcase-intro">
          <h2>
            Every layer, <em>considered.</em>
          </h2>
          <p>
            Six essential systems, planned as one complete experience. Explore
            the technology that makes home feel simpler, richer and more
            responsive.
          </p>
        </div>
        <div class="service-list">
          {coreServices.map((service, index) => (
            <article class="service-container" style={`--stack: ${index + 1}`}>
              <div class="service-card">
                <div class="service-copy">
                  <div>
                    <p class="service-brand">{service.label}</p>
                    <span class="service-index">{service.number}</span>
                  </div>
                  <h3>{service.title}</h3>
                  <p class="service-summary">{service.description}</p>
                  <p class="service-detail">{service.detail}</p>
                  <a href={service.href} class="service-cta">
                    {service.tag} <span>&rarr;</span>
                  </a>
                </div>
                <div class="service-media">
                  <img src={service.image} alt="" loading="lazy" />
                  <span class="service-image-label">NOVA</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="why-nova" id="why-nova">
        <div class="why-heading">
          <p class="eyebrow">NOVA / Built differently</p>
          <h2>
            Technology with <em>intention.</em>
          </h2>
        </div>
        <div class="why-grid" data-why-grid>
          <article class="why-card why-experience">
            <img
              src="/images/network-luxury-home.webp"
              alt="Contemporary luxury home at twilight"
              loading="lazy"
            />
            <div class="why-shade"></div>
            <div class="why-card-content">
              <h3>Designed around real life.</h3>
              <p>
                We begin with the way a home feels, functions and evolves - then
                quietly shape technology around it.
              </p>
              <div class="experience-bottom">
                <h4>A deliberate process</h4>
                <p>
                  One focused team aligns every decision with your architecture,
                  your routine and your long-term plans.
                </p>
                <a href="#contact">
                  Plan your project <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
          <article class="why-card why-trusted">
            <p class="card-kicker">Quietly dependable</p>
            <h3>
              Built to
              <br />
              <em>last.</em>
            </h3>
            <p>
              Trusted systems, installed with care and supported for the long
              run.
            </p>
            <div class="partner-row">
              <span>CONTROL</span>
              <span>LIGHT</span>
              <span>NETWORK</span>
            </div>
          </article>
          <article class="why-card why-years">
            <div>
              <strong>14</strong>
              <span>years</span>
            </div>
            <p>Creating considered technology for homes that demand more.</p>
          </article>
          <article class="why-card why-support">
            <h3>
              Always within
              <br />
              <em>reach.</em>
            </h3>
            <p>
              Responsive support and remote care keep your systems performing
              beautifully after handover.
            </p>
            <a href="#contact">
              Meet our support <span>&rarr;</span>
            </a>
          </article>
          <article class="why-card why-principal">
            <img
              src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1000&q=85"
              alt="Warm contemporary living room with considered lighting"
              loading="lazy"
            />
            <div>
              <p class="card-kicker">NOVA standard</p>
              <h3>Details make the difference.</h3>
              <p>Designed, installed and refined as one seamless experience.</p>
            </div>
          </article>
          <article class="why-card why-planning">
            <img
              src="/images/novara-consultation.jpg"
              alt="Homeowners discussing a home project with a design consultant"
              loading="lazy"
            />
            <div class="planning-shade"></div>
            <div class="planning-content">
              <div class="planning-heading">
                <p class="card-kicker">Clear from the start</p>
                <h3>
                  Plan with
                  <br />
                  <em>clarity.</em>
                </h3>
              </div>
              <div class="planning-body">
                <p>
                  We coordinate the systems plan early, so every decision stays
                  clear and every trade moves with confidence.
                </p>
                <a href="#contact">
                  See our process <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
          <article class="why-card why-showroom">
            <img
              src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=85"
              alt="Bright living space opening to the garden"
              loading="lazy"
            />
            <div class="showroom-shade"></div>
            <div class="showroom-content">
              <p class="card-kicker">NOVA Experience Studio</p>
              <h3>
                Step inside
                <br />
                the <em>idea.</em>
              </h3>
              <p>
                Experience the feeling of a considered home before we create one
                for you.
              </p>
              <a href="#contact">
                Arrange a studio visit <span>&rarr;</span>
              </a>
            </div>
          </article>
        </div>
      </section>
      <section
        class="client-reviews"
        id="reviews"
        aria-labelledby="reviews-heading"
        data-reviews={JSON.stringify(clientReviews)}
      >
        <div class="reviews-heading">
          <p class="eyebrow">NOVA / Client stories</p>
          <h2 id="reviews-heading">
            Good work is <em>felt.</em>
          </h2>
        </div>
        <div class="review-feature" aria-live="polite">
          <button
            class="review-arrow"
            type="button"
            data-review-previous
            aria-label="Previous client review"
          >
            &larr;
          </button>
          <div class="review-portrait">
            <img
              src={clientReviews[0].image}
              alt={clientReviews[0].imageAlt}
              data-review-image
              loading="lazy"
            />
          </div>
          <div class="review-copy">
            <p class="review-source">A NOVA client</p>
            <blockquote data-review-quote>{clientReviews[0].quote}</blockquote>
            <p class="review-client" data-review-client>
              {clientReviews[0].client}
            </p>
            <p class="review-location" data-review-location>
              {clientReviews[0].location}
            </p>
          </div>
          <button
            class="review-arrow"
            type="button"
            data-review-next
            aria-label="Next client review"
          >
            &rarr;
          </button>
          <p
            class="review-counter"
            data-review-counter
            aria-label="Review 1 of 3"
          >
            01 <span>/</span> 03
          </p>
        </div>
        <div class="review-projects" aria-label="Featured project areas">
          <div>
            <span>01 / CONNECTED LIVING</span>
            <p>Whole-home control</p>
          </div>
          <div>
            <span>02 / ATMOSPHERE</span>
            <p>Lighting &amp; shading</p>
          </div>
          <div>
            <span>03 / ENTERTAINMENT</span>
            <p>Audio &amp; cinema</p>
          </div>
        </div>
      </section>
      <section class="consultation" id="contact">
        <div class="consultation-heading">
          <h2>
            Find a time that
            <br />
            <em>works for you.</em>
          </h2>
        </div>
        <div class="booking-layout">
          <div class="booking-visual">
            <img
              src="/images/novara-consultation.jpg"
              alt="A couple meeting with a home design consultant"
              loading="lazy"
            />
            <div class="booking-visual-shade"></div>
            <div class="booking-visual-copy">
              <span>NOVA / PRIVATE CONSULTATION</span>
            </div>
          </div>
          <div class="booking-panel">
            <div class="booking-tabs" role="tablist">
              <button
                class="booking-tab is-active"
                type="button"
                role="tab"
                aria-selected="true"
              >
                Studio visit
              </button>
              <button
                class="booking-tab"
                type="button"
                role="tab"
                aria-selected="false"
              >
                Project call
              </button>
            </div>
            <div class="booking-panel-intro">
              <h3>October 2026</h3>
            </div>
            <div class="booking-weekdays">
              <span>Mon</span>
              <span>Tue</span>
              <span>Wed</span>
              <span>Thu</span>
              <span>Fri</span>
              <span>Sat</span>
              <span>Sun</span>
            </div>
            <div class="booking-days" aria-label="Select a date">
              <button type="button" disabled>
                28
              </button>
              <button type="button" disabled>
                29
              </button>
              <button type="button" disabled>
                30
              </button>
              <button type="button">1</button>
              <button type="button">2</button>
              <button type="button" disabled>
                3
              </button>
              <button type="button" disabled>
                4
              </button>
              <button type="button">5</button>
              <button type="button">6</button>
              <button type="button">7</button>
              <button type="button">8</button>
              <button type="button">9</button>
              <button type="button" disabled>
                10
              </button>
              <button type="button" disabled>
                11
              </button>
              <button type="button">12</button>
              <button type="button">13</button>
              <button type="button">14</button>
              <button type="button">15</button>
              <button type="button">16</button>
              <button type="button" disabled>
                17
              </button>
              <button type="button" disabled>
                18
              </button>
              <button type="button">19</button>
              <button type="button">20</button>
              <button type="button">21</button>
              <button type="button">22</button>
              <button type="button">23</button>
              <button type="button" disabled>
                24
              </button>
              <button type="button" disabled>
                25
              </button>
              <button type="button">26</button>
              <button type="button">27</button>
              <button type="button">28</button>
              <button type="button">29</button>
              <button type="button">30</button>
              <button type="button" disabled>
                31
              </button>
            </div>
            <div class="booking-selection">
              <span>Select a date to view available times.</span>
              <button type="button">
                Continue <b>&rarr;</b>
              </button>
            </div>
          </div>
        </div>
        <div class="consultation-connector">
          <span></span>
          <p>Prefer to write first?</p>
          <span></span>
        </div>
        <div class="contact-studio-card">
          <div class="contact-studio-heading">
            <h3>
              Send a <em>message.</em>
            </h3>
          </div>
          <div class="contact-studio-grid">
            <form class="consultation-form">
              <div class="form-row">
                <label>
                  YOUR NAME
                  <input type="text" placeholder="First and last name" />
                </label>
                <label>
                  EMAIL ADDRESS
                  <input type="email" placeholder="you@example.com" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  PHONE
                  <input type="tel" placeholder="Your preferred number" />
                </label>
                <label>
                  PROJECT LOCATION
                  <input type="text" placeholder="City or postcode" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  PROJECT TYPE
                  <select>
                    <option>Select a project type</option>
                    <option>New build</option>
                    <option>Renovation</option>
                    <option>Focused upgrade</option>
                  </select>
                </label>
                <label>
                  IDEAL TIMELINE
                  <select>
                    <option>Select a timeframe</option>
                    <option>Within 3 months</option>
                    <option>3–6 months</option>
                    <option>6+ months</option>
                  </select>
                </label>
              </div>
              <label class="message-field">
                YOUR NOTE
                <textarea placeholder="Tell us a little about your home and what you have in mind."></textarea>
              </label>
              <button type="submit">
                Send your note <span>&rarr;</span>
              </button>
            </form>
            <div class="contact-studio-image">
              <img
                src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85"
                alt="A contemporary home with thoughtful architectural lighting and integrated technology"
                loading="lazy"
              />
              <span>Visit the NOVA experience studio</span>
            </div>
          </div>
          <div class="contact-studio-footer">
            <a href="tel:+4402071234567">+44 (0)20 7123 4567</a>
            <p>18 Greville Street, London EC1N 8SQ</p>
            <a href="#top">
              Get directions <span>&rarr;</span>
            </a>
          </div>
        </div>
      </section>
      <section class="journal" id="journal">
        <div class="journal-intro">
          <h2>Studio Stories</h2>
        </div>
        <div class="journal-grid">
          {journalPosts.map((post, index) => (
            <a
              class:list={[
                "journal-card",
                {
                  "is-featured": index === 0 || index === 8,
                  "is-wide": index === 6 || index === 9,
                },
              ]}
              href={"/journal/" + post.slug}
            >
              <img
                src={post.image}
                alt={post.alt}
                loading="lazy"
              />
              <div class="journal-card-shade"></div>
              <div class="journal-card-content">
                <p>{post.category}</p>
                <h3>{post.title}</h3>
              </div>
            </a>
          ))}
        </div>
        <a class="journal-more" href="/journal">
          Read more <span aria-hidden="true">&rarr;</span>
        </a>
      </section>
    </main>
    <script>
      const reviewSection = document.querySelector("[data-reviews]");
      if (reviewSection) {
        const reviews = JSON.parse(reviewSection.dataset.reviews || "[]");
        const reviewImage = reviewSection.querySelector("[data-review-image]");
        const reviewQuote = reviewSection.querySelector("[data-review-quote]");
        const reviewClient = reviewSection.querySelector(
          "[data-review-client]",
        );
        const reviewLocation = reviewSection.querySelector(
          "[data-review-location]",
        );
        const reviewCounter = reviewSection.querySelector(
          "[data-review-counter]",
        );
        let currentReview = 0;

        const showReview = (step) => {
          currentReview =
            (currentReview + step + reviews.length) % reviews.length;
          const review = reviews[currentReview];
          reviewImage.src = review.image;
          reviewImage.alt = review.imageAlt;
          reviewQuote.textContent = `“${review.quote}”`;
          reviewClient.textContent = review.client;
          reviewLocation.textContent = review.location;
          reviewCounter.textContent = `${String(currentReview + 1).padStart(2, "0")} / ${String(reviews.length).padStart(2, "0")}`;
          reviewCounter.setAttribute(
            "aria-label",
            `Review ${currentReview + 1} of ${reviews.length}`,
          );
        };

        reviewSection
          .querySelector("[data-review-previous]")
          .addEventListener("click", () => showReview(-1));
        reviewSection
          .querySelector("[data-review-next]")
          .addEventListener("click", () => showReview(1));
      }
    </script>
    <script>
      document.querySelectorAll(".booking-tab").forEach((tab) =>
        tab.addEventListener("click", () => {
          document.querySelectorAll(".booking-tab").forEach((item) => {
            item.classList.remove("is-active");
            item.setAttribute("aria-selected", "false");
          });
          tab.classList.add("is-active");
          tab.setAttribute("aria-selected", "true");
        }),
      );
      document
        .querySelectorAll(".booking-days button:not(:disabled)")
        .forEach((day) =>
          day.addEventListener("click", () => {
            document
              .querySelectorAll(".booking-days button")
              .forEach((item) => item.classList.remove("is-selected"));
            day.classList.add("is-selected");
            document.querySelector(".booking-selection span").textContent =
              `Selected October ${day.textContent} - available times will appear here.`;
          }),
        );
      document
        .querySelector(".consultation-form")
        ?.addEventListener("submit", (event) => {
          event.preventDefault();
          const button = event.currentTarget.querySelector("button");
          button.innerHTML = "Message received <span>&rarr;</span>";
        });
    </script>
    <script>
      const whyGrid = document.querySelector("[data-why-grid]");
      if (whyGrid) {
        whyGrid.classList.add("has-reveal");
        const whyObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                whyObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.14 },
        );
        whyGrid
          .querySelectorAll(".why-card")
          .forEach((card) => whyObserver.observe(card));
      }
    </script>
    <script>
      const stackedServices = document.querySelector(".service-list");
      if (stackedServices) {
        const stackedCards =
          stackedServices.querySelectorAll(".service-container");
        stackedServices.classList.add("has-reveal");
        const stackedObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                stackedObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 },
        );
        stackedCards.forEach((card) => stackedObserver.observe(card));
      }
    </script>
    <script>
      const projectCarousel = document.querySelector("[data-project-carousel]");
      const scrollProjects = (direction) =>
        projectCarousel?.scrollBy({
          left: projectCarousel.clientWidth * direction * 0.78,
          behavior: "smooth",
        });
      document
        .querySelector("[data-project-prev]")
        ?.addEventListener("click", () => scrollProjects(-1));
      document
        .querySelector("[data-project-next]")
        ?.addEventListener("click", () => scrollProjects(1));
      if (projectCarousel) {
        let pointerStartX = 0;
        let carouselStart = 0;
        let dragged = false;
        projectCarousel.addEventListener("pointerdown", (event) => {
          pointerStartX = event.clientX;
          carouselStart = projectCarousel.scrollLeft;
          dragged = false;
          projectCarousel.classList.add("is-dragging");
          projectCarousel.setPointerCapture(event.pointerId);
        });
        projectCarousel.addEventListener("pointermove", (event) => {
          if (!projectCarousel.classList.contains("is-dragging")) return;
          const distance = event.clientX - pointerStartX;
          if (Math.abs(distance) > 4) dragged = true;
          projectCarousel.scrollLeft = carouselStart - distance;
        });
        const endDrag = () => projectCarousel.classList.remove("is-dragging");
        projectCarousel.addEventListener("pointerup", endDrag);
        projectCarousel.addEventListener("pointercancel", endDrag);
        projectCarousel.addEventListener(
          "click",
          (event) => {
            if (dragged) {
              event.preventDefault();
              event.stopPropagation();
              dragged = false;
            }
          },
          true,
        );
      }
    </script>
