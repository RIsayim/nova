  /* Client reviews */
  .client-reviews {
    position: relative;
    overflow: hidden;
    padding: 112px 8.5vw 96px;
    background: #11120f;
    color: var(--color-text);
    isolation: isolate;
  }
  .client-reviews::before {
    position: absolute;
    z-index: -1;
    inset: 35px 10% 165px;
    background-image: radial-gradient(
      circle,
      rgba(244, 241, 234, 0.14) 0.8px,
      transparent 1px
    );
    background-position: center;
    background-size: 8px 8px;
    content: "";
    opacity: 0.36;
    mask-image: radial-gradient(
      ellipse 48% 48% at 50% 48%,
      #000 35%,
      transparent 100%
    );
  }
  .reviews-heading {
    margin: 0 auto 48px;
    text-align: center;
  }
  .reviews-heading .eyebrow {
    margin: 0 0 12px;
    color: var(--color-accent);
  }
  .reviews-heading h2 {
    margin: 0;
    font-size: clamp(38px, 4.1vw, 62px);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  .reviews-heading h2 em {
    color: var(--color-accent);
    font-size: 0.82em;
    font-weight: 500;
  }
  .review-feature {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(180px, 270px) minmax(0, 570px) 44px;
    gap: 30px;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 0 64px;
  }
  .review-portrait {
    height: 270px;
    overflow: hidden;
    border-radius: 5px;
    background: var(--color-surface-raised);
  }
  .review-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 36%;
  }
  .review-copy {
    min-width: 0;
  }
  .review-source {
    margin: 0 0 20px;
    color: var(--color-accent);
    font: 500 11px var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .review-copy blockquote {
    margin: 0;
