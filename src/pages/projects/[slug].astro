const { project } = Astro.props;
const projectImages = project.images;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={project.description}
    />
    <meta name="theme-color" content="#090909" />
    <title>{project.title} — NOVA Project</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
      <link rel="stylesheet" href="/site-motion.css" />
    <script src="/site-motion.js" defer></script>
  </head>
  <body>
    <header class="site-header" id="top">
      <a class="brand" href="/" aria-label="NOVA home">
        NOVA<span></span>
      </a>
      <nav aria-label="Primary navigation" id="primary-navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/journal">Journal</a>
        <a href="/projects" aria-current="page">Projects</a>
        <div class="services-menu">
          <button
            class="services-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Core services <span aria-hidden="true">+</span>
          </button>
          <div class="services-dropdown">
            <a href="/services/security-cameras">Security &amp; Cameras</a>
            <a href="/services/home-network-wifi">Home Network &amp; WiFi</a>
            <a href="/services/whole-home-audio">Whole-Home Audio</a>
            <a href="/services/intelligent-lighting">Intelligent Lighting</a>
            <a href="/services/automated-shades">Automated Shades</a>
            <a href="/services/home-theater">Home Theater</a>
          </div>
        </div>
      </nav>
      <a class="header-cta" href="/consultation">
        Start a project <i aria-hidden="true">&rarr;</i>
      </a>
      <button
        class="menu"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span></span>
        <span></span>
      </button>
    </header>

    <main class="project-detail">
      <section class="project-detail-intro" aria-labelledby="project-detail-title">
        <div class="project-detail-intro-inner">
          <div class="project-detail-heading">
            <h1 id="project-detail-title">{project.title}</h1>
            <p>{project.description}</p>
          </div>
        </div>
      </section>

      <section class="project-cover" aria-label={project.title}>
        <img
          src={project.hero}
          alt={project.heroAlt}
          fetchpriority="high"
        />
        <div class="project-cover-caption">
          <span>{project.title}</span>
          <span>01 / {project.images.length.toString().padStart(2, "0")}</span>
        </div>
      </section>

      <section class="project-story" aria-label={project.title + " project story"}>
        <aside class="project-story-sidebar">
          <div class="project-story-sticky">
            <p class="eyebrow"><span></span> Project overview</p>
            <h2>{project.overviewTitle}</h2>
            <p class="project-story-lead">{project.lead}</p>
            <p>{project.story}</p>
            <dl class="project-facts">
              {project.facts.map((fact) => (
                <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
              ))}
            </dl>
          </div>
        </aside>

        <div class="project-gallery" aria-label={project.title + " interiors"}>
          {projectImages.map((item, index) => (
            <figure class="project-gallery-frame" style={"--image-index: " + index}>
              <img src={item.image} alt={item.alt} loading="lazy" />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="project-detail-closer">
        <p class="eyebrow"><span></span> Your home, thoughtfully connected</p>
        <h2>Let’s shape a home around <em>your life.</em></h2>
        <a class="button button-primary" href="/consultation">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand-column">
          <a class="footer-logo" href="/" aria-label="NOVA home">
            NOVA<span aria-hidden="true"></span>
          </a>
          <p class="footer-brand-line">
            Intelligent spaces, simply considered. Thoughtful technology,
            designed around the way you live.
          </p>
        </div>
        <nav class="footer-links" aria-label="Experiences">
          <h2>Experiences</h2>
          <a href="/services/home-network-wifi">Smart home control</a>
          <a href="/services/home-theater">Home theater</a>
          <a href="/services/whole-home-audio">Whole-home audio</a>
          <a href="/services/intelligent-lighting">Lighting design</a>
          <a href="/services/automated-shades">Lighting control &amp; shades</a>
          <a href="/services/security-cameras">Security &amp; cameras</a>
        </nav>
        <nav class="footer-links" aria-label="Studio">
          <h2>Studio</h2>
          <a href="/about#our-approach">Our approach</a>
          <a href="/projects">Projects</a>
          <a href="/journal">Journal</a>
          <a href="/#reviews">Client stories</a>
          <a href="/#contact">Contact</a>
          <a href="/#contact">Service &amp; support</a>
        </nav>
        <div class="footer-links footer-areas">
          <h2>Service areas</h2>
          <span>London</span>
          <span>Greater London</span>
          <span>Surrey &amp; Home Counties</span>
          <span>By consultation</span>
        </div>
        <div class="footer-contact">
          <h2>Visit</h2>
          <p class="footer-location-label">London studio</p>
          <address>
            <span>18 Greville Street,</span>
            <span>London EC1N 8SQ</span>
          </address>
          <a class="footer-phone" href="tel:+4402071234567">
            +44 (0)20 7123 4567
          </a>
          <a
            class="footer-directions"
            href="https://maps.google.com/?q=18+Greville+Street+London+EC1N+8SQ"
          >
            Get directions <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 NOVA Home Technology</p>
        <a href="#top">
          Back to top <span aria-hidden="true">&uarr;</span>
        </a>
        <p>Designed around real life.</p>
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector(".menu");
      const navigation = document.querySelector("#primary-navigation");
      const servicesMenu = document.querySelector(".services-menu");
      const servicesTrigger = document.querySelector(".services-trigger");

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        menuButton.setAttribute(
          "aria-label",
          isOpen ? "Open navigation" : "Close navigation",
        );
        navigation?.classList.toggle("is-open", !isOpen);
      });

      servicesTrigger?.addEventListener("click", () => {
        const isOpen = servicesTrigger.getAttribute("aria-expanded") === "true";
        servicesTrigger.setAttribute("aria-expanded", String(!isOpen));
        servicesMenu?.classList.toggle("is-open", !isOpen);
      });
    </script>
  </body>
</html>

<style>
  :root {
    --color-background: #090909;
    --color-surface: #11120f;
    --color-text: #f4f1ea;
    --color-text-muted: #d0ccc3;
    --color-accent: #bf974e;
    --color-border: rgba(244, 241, 234, 0.2);
    --color-accent-hover: #d4ae68;
    --primary: "Montserrat", sans-serif;
    --sans: "Poppins", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--sans);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    height: 82px;
    align-items: center;
    padding: 0 clamp(22px, 3.2vw, 64px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(5, 5, 5, 0.94);
    color: #fff;
    backdrop-filter: blur(12px);
  }

  .brand {
    display: inline-flex;
    align-items: flex-start;
    font: 700 28px/1 var(--primary);
    letter-spacing: -0.08em;
  }

  .brand span {
    width: 7px;
    height: 7px;
    margin: 3px 0 0 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 31px);
    margin: 0 clamp(25px, 4vw, 70px) 0 auto;
    font-size: 14px;
    font-weight: 500;
  }

  .site-header nav > a {
    color: rgba(255, 255, 255, 0.88);
    transition: color 180ms ease;
  }

  .site-header nav > a:hover {
    color: #fff;
  }

  .site-header nav > a[aria-current="page"] {
