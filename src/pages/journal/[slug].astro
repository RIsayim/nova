  .journal-page {
    padding: clamp(76px, 9vw, 122px) 24px clamp(92px, 10vw, 140px);
    background: #090909;
  }

  .journal-page-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .journal-card {
    position: relative;
    display: flex;
    min-height: 430px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #fff;
    isolation: isolate;
  }

  .journal-card.is-featured,
  .journal-card.is-wide {
    grid-column: span 2;
  }

  .journal-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .journal-card:hover > img {
    transform: scale(1.055);
  }

  .journal-card-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(3, 3, 3, 0.05) 30%, rgba(3, 3, 3, 0.88) 100%);
  }

  .journal-card-link {
    position: absolute;
    z-index: 2;
    inset: 0;
  }

  .journal-card:focus-within {
    outline: 2px solid var(--color-accent-hover);
    outline-offset: 4px;
  }

  .journal-card-content {
    position: relative;
    z-index: 3;
    display: flex;
    width: 100%;
    pointer-events: none;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 28px;
  }

  .journal-card-content p {
    margin: 0 0 14px;
    color: rgba(255, 255, 255, 0.76);
    font: 500 11px var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journal-card-content h3 {
    max-width: 440px;
    margin: 0;
    color: #fff;
    font: 500 clamp(23px, 2vw, 34px)/1.08 var(--primary);
    letter-spacing: -0.055em;
  }

  @media (max-width: 1100px) {
    .journal-page-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .journal-card.is-featured,
    .journal-card.is-wide {
      grid-column: span 2;
    }

  }

  @media (max-width: 650px) {
    .journal-page {
      padding: 70px 22px 85px;
    }

    .journal-page-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .journal-card.is-featured,
    .journal-card.is-wide {
      grid-column: auto;
    }

    .journal-card {
      min-height: 360px;
    }

    .journal-card-content {
      padding: 24px;
    }
  }




  .journal-article {
