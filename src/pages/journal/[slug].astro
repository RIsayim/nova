  .article-toc li { border-top: 1px solid var(--color-border); }
  .article-toc li:last-child { border-bottom: 1px solid var(--color-border); }
  .article-toc a {
    display: block;
    padding: 16px 0 16px 10px;
    border-left: 2px solid transparent;
    color: rgba(244,241,234,.78);
