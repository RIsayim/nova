    top: 112px;
    align-self: start;
    padding-top: 5px;
  }
  .article-toc > p {
    margin: 0 0 18px;
    color: var(--color-accent-hover);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
