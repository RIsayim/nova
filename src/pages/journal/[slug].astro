    color: #f4f1ea;
    font: 500 clamp(28px, 3vw, 39px)/1.14 var(--primary);
    letter-spacing: -.05em;
  }
  .article-section > p {
    margin: 0 0 17px;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.9;
  }
  .article-inline-image {
    position: relative;
    height: clamp(260px, 36vw, 470px);
    margin: 52px 0 64px;
    overflow: hidden;
    background: #171613;
  }
  .article-inline-image figcaption {
    right: 16px;
    bottom: 15px;
    left: 16px;
    font-size: 10px;
  }
  .article-media {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--color-border);
  }
  .article-media-heading { max-width: 660px; margin-bottom: 20px; }
  .article-media-heading > span { color: var(--color-accent-hover); font-size: 9px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .article-media-heading h3 { margin: 9px 0 8px; color: #f4f1ea; font: 500 clamp(21px, 2.3vw, 29px)/1.2 var(--primary); letter-spacing: -.04em; }
  .article-media-heading p { margin: 0; color: var(--color-text-muted); font-size: 13px; line-height: 1.75; }
  .article-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .article-gallery figure, .article-slide, .article-video { position: relative; min-width: 0; margin: 0; overflow: hidden; background: #171613; }
