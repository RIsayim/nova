    display: grid;
    grid-template-columns: minmax(180px, .32fr) minmax(0, 1fr);
    gap: clamp(45px, 8vw, 130px);
    width: min(calc(100% - 48px), 1320px);
    margin: 0 auto;
    padding: clamp(76px, 9vw, 120px) 0 130px;
