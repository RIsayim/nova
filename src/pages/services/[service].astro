    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
      <link rel="stylesheet" href="/site-motion.css" />
    <script src="/site-motion.js" defer></script>
  </head>
  <body>
    <header class="site-header" id="top">
      <a class="brand" href="/" aria-label="NOVA home">NOVA<span></span></a>
      <nav aria-label="Primary navigation" id="primary-navigation">
        <a href="/">Home</a><a href="/about">About</a><a href="/journal">Journal</a><a href="/projects">Projects</a>
        <div class="services-menu"><button class="services-trigger" type="button" aria-haspopup="true" aria-expanded="false">Core services <span aria-hidden="true">+</span></button><div class="services-dropdown">
          <a href="/services/security-cameras" aria-current={service === 'security-cameras' ? 'page' : undefined}>Security &amp; Cameras</a><a href="/services/home-network-wifi" aria-current={service === 'home-network-wifi' ? 'page' : undefined}>Home Network &amp; WiFi</a><a href="/services/whole-home-audio" aria-current={service === 'whole-home-audio' ? 'page' : undefined}>Whole-Home Audio</a><a href="/services/intelligent-lighting" aria-current={service === 'intelligent-lighting' ? 'page' : undefined}>Intelligent Lighting</a><a href="/services/automated-shades" aria-current={service === 'automated-shades' ? 'page' : undefined}>Automated Shades</a><a href="/services/home-theater" aria-current={service === 'home-theater' ? 'page' : undefined}>Home Theater</a>
        </div></div>
      </nav><a class="header-cta" href="/consultation">Start a project <i aria-hidden="true">&rarr;</i></a><button class="menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span></button>
    </header>
    <main class="service-page audio-service-page">
      <section class:list={["about-hero", "audio-hero", service === "security-cameras" && "security-service-hero", service === "intelligent-lighting" && "lighting-service-hero"]} aria-labelledby="service-title">
        {pageData.heroVideo ? <video class="hero-video" muted loop playsinline preload="none" poster={pageData.heroImage} data-autoplay-loop aria-hidden="true"><source src={pageData.heroVideo} type="video/mp4" /></video> : <div class="hero-image" style={'background-image: url(' + pageData.heroImage + ')'} aria-hidden="true"></div>}
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <p class="eyebrow"><span></span> {pageData.eyebrow}</p><h1 id="service-title">{pageData.lead} <span>{pageData.accent}</span></h1>
          <p class="hero-intro">{pageData.intro}</p><p class="hero-belief">{pageData.belief}</p>
          <div class="hero-actions"><a class="button button-secondary" href="/projects">Discover our work <span aria-hidden="true">↗</span></a><a class="button button-primary" href="/consultation">Schedule a consultation <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="hero-foot"><span>Thoughtful technology, considered around you.</span><a href="/projects">Explore projects <span aria-hidden="true">↓</span></a></div>
      </section>
      <section class="audio-planning" aria-labelledby="service-planning-title">
        <header class="audio-planning-intro"><p class="audio-section-kicker">{pageData.planKicker}</p><h2 id="service-planning-title">{pageData.planTitle}</h2><p>{pageData.planIntro}</p></header>
        <div class="audio-planning-grid"><div class="audio-sticky-column"><div class="audio-sticky-copy"><p class="audio-section-kicker">{pageData.planKicker}</p><h3>{pageData.stickyTitle}</h3><p>{pageData.stickyCopy}</p></div>
          <figure class="audio-feature-media">{pageData.featureVideo ? <video muted loop playsinline preload="none" poster={pageData.featureImage} data-autoplay-loop aria-hidden="true"><source src={pageData.featureVideo} type="video/mp4" /></video> : <img src={pageData.featureImage} alt={pageData.stickyTitle} loading="lazy" />}<figcaption>Every detail selected for a more natural experience at home.</figcaption></figure>
        </div><div class="audio-solution-grid">{pageData.solutions.map(([label, heading, copy, image]) => (<article class="audio-solution-card"><figure class="audio-solution-visual"><img src={image} alt={heading} loading="lazy" /><span>{label}</span></figure><div class="audio-solution-copy"><h3>{heading}</h3><p>{copy}</p></div></article>))}</div></div>
      </section>
      <section class="outdoor-audio" aria-labelledby="service-experience-title">
        <header class="outdoor-audio-intro"><p class="audio-section-kicker">{pageData.expKicker}</p><h2 id="service-experience-title">{pageData.expTitle}</h2><p>{pageData.expIntro}</p></header>
        <div class="outdoor-audio-grid">{pageData.experiences.map(([label, heading, copy, image]) => (<article class="outdoor-audio-card"><figure class="outdoor-card-visual"><img src={image} alt={heading} loading="lazy" /><span>{label}</span></figure><div class="outdoor-card-copy"><h3>{heading}</h3><p>{copy}</p></div></article>))}</div>
        <div class="outdoor-audio-stories"><article class="outdoor-story outdoor-story-video"><div class="outdoor-story-copy"><p class="audio-section-kicker">{pageData.expKicker}</p><h3>{pageData.story1Title}</h3><p>{pageData.story1}</p></div><figure class="outdoor-story-media">{pageData.story1Video ? <video muted loop playsinline preload="none" poster={pageData.story1Image} data-autoplay-loop aria-hidden="true"><source src={pageData.story1Video} type="video/mp4" /></video> : <img src={pageData.story1Image} alt={pageData.story1Title} loading="lazy" />}<figcaption>Technology, thoughtfully integrated into everyday life.</figcaption></figure></article>
          <article class="outdoor-story outdoor-story-image"><div class="outdoor-story-copy"><p class="audio-section-kicker">Personal by design</p><h3>{pageData.story2Title}</h3><p>{pageData.story2}</p></div><figure class="outdoor-story-media"><img src={pageData.story2Image} alt={pageData.story2Title} loading="lazy" /><figcaption>A considered experience, made around you.</figcaption></figure></article></div>
      </section>
      <section class="about-closer audio-closer" aria-labelledby="service-closer-title"><div class="closing-image" style={'background-image: url(' + pageData.closeImage + ')'} aria-hidden="true"></div><div class="closing-overlay"></div><div class="closing-content"><p class="eyebrow"><span></span> {pageData.closeKicker}</p><h2 id="service-closer-title" class="closing-title">{pageData.closeLead} <em>{pageData.closeAccent}</em></h2><p class="closing-copy">{pageData.closeCopy}</p><a class="closing-cta" href="/consultation">Schedule a consultation <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand-column">
          <a class="footer-logo" href="/" aria-label="NOVA home">
            NOVA<span aria-hidden="true"></span>
          </a>
          <p class="footer-brand-line">
            Intelligent spaces, simply considered. Thoughtful technology,
            designed around the way you live.
          </p>
        </div>
        <nav class="footer-links" aria-label="Experiences">
          <h2>Experiences</h2>
          <a href="/services/home-network-wifi">Smart home control</a>
          <a href="/services/home-theater">Home theater</a>
          <a href="/services/whole-home-audio">Whole-home audio</a>
          <a href="/services/intelligent-lighting">Lighting design</a>
          <a href="/services/automated-shades">Lighting control &amp; shades</a>
          <a href="/services/security-cameras">Security &amp; cameras</a>
        </nav>
        <nav class="footer-links" aria-label="Studio">
          <h2>Studio</h2>
          <a href="/about#our-approach">Our approach</a>
          <a href="/projects">Projects</a>
          <a href="/journal">Journal</a>
          <a href="/#reviews">Client stories</a>
          <a href="/#contact">Contact</a>
          <a href="/#contact">Service &amp; support</a>
        </nav>
        <div class="footer-links footer-areas">
          <h2>Service areas</h2>
          <span>London</span>
          <span>Greater London</span>
          <span>Surrey &amp; Home Counties</span>
          <span>By consultation</span>
        </div>
        <div class="footer-contact">
          <h2>Visit</h2>
          <p class="footer-location-label">London studio</p>
          <address>
            <span>18 Greville Street,</span>
            <span>London EC1N 8SQ</span>
          </address>
          <a class="footer-phone" href="tel:+4402071234567">
            +44 (0)20 7123 4567
          </a>
          <a
            class="footer-directions"
            href="https://maps.google.com/?q=18+Greville+Street+London+EC1N+8SQ"
          >
            Get directions <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 NOVA Home Technology</p>
        <a href="#top">
          Back to top <span aria-hidden="true">&uarr;</span>
        </a>
        <p>Designed around real life.</p>
      </div>
    </footer>
    <script>
      const menuButton = document.querySelector(".menu");
      const navigation = document.querySelector("#primary-navigation");
      const servicesMenu = document.querySelector(".services-menu");
      const servicesTrigger = document.querySelector(".services-trigger");
      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        menuButton.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
        navigation?.classList.toggle("is-open", !isOpen);
      });
      servicesTrigger?.addEventListener("click", () => {
        const isOpen = servicesTrigger.getAttribute("aria-expanded") === "true";
        servicesTrigger.setAttribute("aria-expanded", String(!isOpen));
        servicesMenu?.classList.toggle("is-open", !isOpen);
      });
    </script>
  </body>
</html>
<style>
  :root { --lime: #bf974e; --ink: #f4f1ea; --black: #090909; --muted: #b8b3a8; --sans: 'Poppins', sans-serif; --serif: 'Montserrat', sans-serif; --primary: 'Montserrat', sans-serif; }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--black); color: var(--ink); font-family: var(--sans); }
  a { color: inherit; text-decoration: none; }
